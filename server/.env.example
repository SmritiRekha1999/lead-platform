# Copy this file to .env and fill in real values.

# MongoDB connection string. For local dev use a local mongod or a free
# MongoDB Atlas cluster. Example Atlas form:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/leadplatform?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on (Render sets this automatically).
PORT=5000
